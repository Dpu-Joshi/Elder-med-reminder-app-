{
  "name": "medreminder-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"lib/test/unit/**/*.test.js\"",
    "test:emulator": "tsc && firebase emulators:exec --project demo-medreminder --only auth,firestore \"node --test --test-concurrency=1 lib/test/emulator/*.test.js\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.0.0",
    "firebase": "^13.0.0",
    "typescript": "~5.9.3"
  }
}
